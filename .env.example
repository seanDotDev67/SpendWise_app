APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SUPABASE_URL= 
SUPABASE_SERVICE_ROLE_KEY= 
SUPABASE_BUCKET=profile-photos
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# SpendWise AI: multi-provider with automatic failover (see docs/ai-providers.md).
# ASSISTANT_PROVIDER=failover tries providers in the priority order set in config/ai.php:
#   1. Gemini  2. Groq  3. OpenRouter  4. local Ollama (development only).
# A provider without an API key is skipped. Keys are server-side only; never expose them.
# Legacy modes: ASSISTANT_PROVIDER=ollama or =gemini use that single provider with no fallback.
ASSISTANT_PROVIDER=failover
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides (defaults live in config/ai.php).
# AI_GEMINI_MODEL=gemini-2.5-flash
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# AI_OPENROUTER_ALLOW_PAID=false
# AI_MAX_ATTEMPTS=3
# AI_COOLDOWN_RATE_LIMITED=60

# Local Ollama: used automatically when APP_ENV=local; set AI_OLLAMA_ENABLED=true to force it elsewhere.
# Setup: install Ollama, then run `ollama pull llama3.2:3b` (see README).
# "localhost" means the machine running Laravel. On a remote server, Ollama must run
# on/near that server; your own PC's Ollama is not reachable from it.
# AI_OLLAMA_ENABLED=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300
OLLAMA_TEMPERATURE=0.3

# GEMINI_MODEL / GEMINI_API_ENDPOINT are still honoured (also used by ASSISTANT_PROVIDER=gemini).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
